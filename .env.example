# Copy to .env. Any OpenAI-compatible chat-completions endpoint works.
# Examples: Groq https://api.groq.com/openai/v1 , OpenRouter https://openrouter.ai/api/v1 ,
# Google https://generativelanguage.googleapis.com/v1beta/openai , Ollama http://localhost:11434/v1
# Never put a real key in this file.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
